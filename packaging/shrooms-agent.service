# shrooms-agent: this machine's Claude Code sessions, served to the owner's
# other devices over the mesh (docs/agents.md).
#
# A user unit, not a system one: sessions run as the user whose Claude Code
# they are — that user's settings, permissions, credentials and files. Run
# as root, every session could do anything on the machine.
#
#   systemctl --user enable --now shrooms-agent
#   loginctl enable-linger $USER    # keep it running while logged out
#
# Serves on every mesh this device is in; to limit that, override ExecStart
# with --meshes office,home (systemctl --user edit shrooms-agent).
[Unit]
Description=shrooms-agent: Claude Code sessions over the mesh
After=network-online.target

[Service]
# Through a login shell, so sessions find what the user's terminal finds —
# nix, go, cargo, Claude Code itself — rather than a unit's bare PATH. A
# session that cannot run `nix build` is a worse agent, and says so only by
# failing (2026-10-03).
ExecStart=/bin/bash -lc 'exec /usr/local/bin/shrooms-agent'
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
